<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<PackageId>DSoft.CacheManager.LiteDB</PackageId>
		<Product>DSoft.CacheManager.LiteDB</Product>
		<PackageTags>cache netstandard</PackageTags>
		<Description>LiteDB backend for DSoft.CacheManager</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>DSIcon.png</PackageIcon>
		<PackageReleaseNotes>Added support for .NET 10.0 and .NET 11.0</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="LiteDB.Config" Version="5.0.21.11" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net11.0' ">
		<PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' != 'net11.0' ">
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CacheManager\DSoft.CacheManager.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="\" />
		<None Include="../DSIcon.png" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>

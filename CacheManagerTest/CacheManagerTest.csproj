<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net10.0-windows;net11.0-windows</TargetFrameworks>
		<UseWPF>true</UseWPF>
		<SignAssembly>false</SignAssembly>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DSoft.System.Mvvm.Hosting" Version="3.6.2611.2" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net11.0-windows' ">
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' != 'net11.0-windows' ">
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CacheManager\DSoft.CacheManager.csproj" />
		<ProjectReference Include="..\DSoft.CacheManager.LiteDB\DSoft.CacheManager.LiteDB.csproj" />
	</ItemGroup>

</Project>
